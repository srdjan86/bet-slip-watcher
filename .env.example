# YouTube live/VOD URL (friend's desktop stream)
STREAM_URL=https://youtu.be/xAz4C3Sw_aY

# Recommended (Mac): dedicated Firefox profile for the stream Google account only.
# 1) Firefox → about:profiles → create "Stream" profile, sign in on YouTube
# 2) Root Directory ends with e.g. skqlrte6.Stream — use that folder name below
# 3) yt-dlp --simulate --cookies-from-browser "firefox:YOUR_FOLDER" "$STREAM_URL"
YTDLP_COOKIES_FROM_BROWSER="firefox:skqlrte6.Stream"

# Alternative: Chrome profile (chrome://version → Profile Path folder name)
# YTDLP_COOKIES_FROM_BROWSER="chrome:Profile 3"

# Fallback: manual Netscape cookies.txt (re-export when playback fails)
# STREAMLINK_HTTP_COOKIE_FILE=/Users/you/bet-slip-watcher/secrets/youtube_cookies.txt

# Optional: test on a local image instead of the stream
# DEBUG_IMAGE=/path/to/screenshot.png

# Telegram (optional — leave blank to log to console only)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional ntfy.sh topic (no account needed): https://ntfy.sh/my-secret-topic
NTFY_TOPIC=
